APP_NAME=OCRLab API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://ocrlab:ocrlab@localhost:5432/ocrlab
JWT_SECRET_KEY=development-only-change-this-secret-before-deploying
JWT_ALGORITHM=HS256
JWT_ISSUER=ocrlab-api
JWT_AUDIENCE=ocrlab-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=ocrlab_refresh
DOCUMENT_STORAGE_ROOT=./var/ocrlab/documents
MAX_DOCUMENT_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
MAX_PDF_PAGE_DIMENSION_POINTS=14400

OCR_ENGINE_TIMEOUT_SECONDS=120
OCR_MAX_CONCURRENT_ENGINES=1
OCR_MAX_RENDERED_IMAGE_BYTES=268435456
OCR_WORKER_POLL_SECONDS=1.0
OCR_WORKER_LEASE_SECONDS=300
OCR_WORKER_MAX_ATTEMPTS=3

OCR_ENABLED_ENGINES=["tesseract"]
OCR_EASYOCR_MODEL_DIRECTORY=
OCR_PADDLE_DETECTION_MODEL_DIRECTORY=
OCR_PADDLE_RECOGNITION_MODEL_DIRECTORY=
OCR_PADDLE_CLASSIFICATION_MODEL_DIRECTORY=
